{
  "explorer.sortOrder": "type",
  "explorer.sortOrderLexicographicOptions": "upper",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "$(capture).test.ts, $(capture).*.test.ts, $(capture).js, $(capture).d.ts",
    "*.mjs": "$(capture).test.mjs",
    "README.md": "CHANGELOG*, LICENSE*, SECURITY*, CLAUDE*, agent-contract.md",
    "package.json": "package-lock.json, .npmrc, .nvmrc, rolldown.config.ts, eslint.config.ts, vitest.config.ts, stryker.config.json, typedoc.json",
    ".gitignore": ".gitattributes"
  },

  // Two trees inside the workspace are generated in bulk and never edited: a worktree
  // under `.claude/worktrees/` carries its own `npm ci` install (~33k files each), and
  // Stryker copies the whole project once per core into `.stryker-tmp`. Watching them
  // exhausted the extension host's file descriptors — `rg` failed to spawn with EMFILE,
  // 35k `spawn EBADF` followed, the host went unresponsive 49 times, and the window
  // renderer crashed twice in one day. VS Code's defaults cover neither path.
  "files.watcherExclude": {
    "**/.claude/worktrees/**": true,
    "**/.stryker-tmp/**": true
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.format.enable": true,
  "eslint.validate": ["javascript", "typescript"],
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  }
}
