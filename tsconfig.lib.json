{
  "compilerOptions": {
    /* Under the tree, never under `node_modules`: several checkouts share one
       `node_modules` here (a worktree symlinks it), and a cache under it is one
       cache keyed against several source trees — local `tsc` passes while a clean
       checkout fails (#235). Each tree has its own root, so this is per-tree by
       construction. Same for the sibling configs. */
    "tsBuildInfoFile": "./.tmp/tsconfig.lib.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode (tsc for typecheck only) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Project references */
    "composite": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["rolldown.config.ts", "eslint.config.ts", "vitest.config.ts", "src"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
