{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    /* `blueprint.config.mjs` is the only JS in the program, and its JSDoc
       `@type` is the whole reason it is included — `allowJs` alone puts the
       file in the program and reports nothing about it. */
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,

    /* Bundler mode (tsc for typecheck only) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Project references */
    "composite": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /* `test` holds the suites that are not co-located with a layer: the
     conformance DSL and the adoption e2e. They are type-checked exactly like
     `src`, and deliberately NOT in `tsconfig.types.json` — nothing here reaches
     `dist/`. */
  "include": [
    "blueprint.config.mjs",
    "rolldown.config.ts",
    "eslint.config.ts",
    "vitest.config.ts",
    "src",
    "test"
  ],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
